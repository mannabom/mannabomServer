# ===========================================
# 만나봄 서버 프로덕션 환경변수
# ===========================================

# 서버 설정
SERVER_PORT=8080

# AWS RDS PostgreSQL 데이터베이스 설정
AWS_RDS_ENDPOINT=your-rds-instance.xxxxxxxxx.ap-northeast-2.rds.amazonaws.com
AWS_RDS_PORT=5432
AWS_RDS_DATABASE=mannabom_db
AWS_RDS_USERNAME=postgres
AWS_RDS_PASSWORD=your-strong-password

# Redis 설정 (EC2에 설치된 Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS 설정
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your-secret-access-key-40-characters-long

# S3 버킷 설정
AWS_S3_BUCKET_NAME=mannabom-storage

# JWT 토큰 설정 (32자 이상 시크릿 추천)
JWT_SECRET=your-super-strong-jwt-secret-key-for-production-32chars-minimum
a
# 카카오 OAuth 설정
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_REDIRECT_URI=https://your-domain.com/api/auth/login/kakao

# 이메일 SMTP 설정
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# ===========================================
# 사용법: EC2에서: export $(cat .env.prod | xargs)
# ===========================================