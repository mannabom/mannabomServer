# ========================================
# 카카오 로그인 요청 (회원가입 시작점)
# ========================================
POST http://localhost:8080/api/auth/login/kakao
Content-Type: application/json

{
  "authorizationCode": "sample_kakao_auth_code",
  "redirectUri": "kakao://oauth"
}

###

# ========================================
# 토큰 갱신 요청
# ========================================
POST http://localhost:8080/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "sample_refresh_token_here"
}

###

# ========================================
# 질문 목록 조회 (회원가입 중 참고용)
# ========================================
GET http://localhost:8080/api/signup/questions

###

# ========================================
# 약관 내용 조회 (회원가입 중 참고용)
# ========================================
GET http://localhost:8080/api/signup/terms

